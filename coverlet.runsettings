<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!--
            Migrations are generated by `dotnet ef` and are verified by the database
            accepting them, not by unit tests. Source-generated OpenAPI and compiler
            plumbing are likewise not ours to test. Counting any of it makes the
            percentage a measure of how many migrations exist rather than how well the
            code is tested.
          -->
          <ExcludeByFile>**/Data/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>

          <Exclude>[TrackBoard.Tests]*</Exclude>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
