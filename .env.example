# Copy to .env and fill in. .env is gitignored and must never be committed.
# These defaults are local throwaway credentials, not production secrets.

POSTGRES_DB=trackboard
POSTGRES_USER=trackboard
POSTGRES_PASSWORD=

ASPNETCORE_ENVIRONMENT=Development

# Production supplies this directly instead of the POSTGRES_* parts above.
# ConnectionStrings__Default=

# JWT signing key. Must be cryptographically random and at least 32 bytes (256 bits) —
# the app refuses to start otherwise. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
