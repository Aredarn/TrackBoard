{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TrackBoard",
    "Audience": "TrackBoard",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 90
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimit": {
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60,
    "GlobalPermitLimit": 300,
    "GlobalWindowSeconds": 60
  },
  "Lockout": {
    "MaxFailedAttempts": 10,
    "WindowMinutes": 15,
    "LockoutMinutes": 15
  },
  "Quotas": {
    "MaxTracks": 100,
    "MaxVehicles": 25,
    "MaxSessions": 1000,
    "MaxHostedEvents": 100
  },
  "Cache": {
    "LeaderboardSeconds": 300,
    "LeaderboardLocalSeconds": 30,
    "WarmupEnabled": true,
    "WarmupSeasons": 2
  }
}
