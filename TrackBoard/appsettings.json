{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TrackBoard",
    "Audience": "TrackBoard",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Cache": {
    "LeaderboardSeconds": 300,
    "LeaderboardLocalSeconds": 30,
    "WarmupEnabled": true,
    "WarmupSeasons": 2
  }
}
